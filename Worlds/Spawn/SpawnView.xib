<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21225" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="21225"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="RDAtlantisSpawn">
            <connections>
                <outlet property="contentView" destination="spawn-content" id="owner-contentView"/>
                <outlet property="splitPlaceholder" destination="spawn-split" id="owner-splitPlaceholder"/>
                <outlet property="outputView" destination="output-text" id="owner-outputView"/>
                <outlet property="inputView" destination="input-text" id="owner-inputView"/>
                <outlet property="timerField" destination="status-timer" id="owner-timerField"/>
                <outlet property="statusField" destination="status-message" id="owner-statusField"/>
                <outlet property="statusBar" destination="spawn-status" id="owner-statusBar"/>
                <outlet property="sslImage" destination="status-lock" id="owner-sslImage"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application"/>
        <customView id="spawn-content" userLabel="Spawn Content">
            <rect key="frame" x="0" y="0" width="617" height="433"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <customView id="spawn-split" userLabel="Spawn Panes">
                    <rect key="frame" x="0" y="0" width="617" height="412"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <scrollView borderType="none" hasHorizontalScroller="NO" hasVerticalScroller="YES" id="output-scroll" customClass="RDScrollView">
                            <rect key="frame" x="0" y="62" width="617" height="350"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <clipView key="contentView" id="output-clip">
                                <rect key="frame" x="0" y="0" width="602" height="350"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <textView importsGraphics="NO" verticallyResizable="YES" editable="NO" id="output-text" customClass="RDTextView">
                                        <rect key="frame" x="0" y="0" width="602" height="14"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <size key="minSize" width="114" height="0"/>
                                        <size key="maxSize" width="602" height="10000000"/>
                                        <connections>
                                            <outlet property="_rdRedirectFocusOnKeyTo" destination="input-text" id="output-keyboard-route"/>
                                        </connections>
                                    </textView>
                                </subviews>
                            </clipView>
                            <scroller key="horizontalScroller" hidden="YES" horizontal="YES" id="output-horizontal">
                                <rect key="frame" x="-100" y="-100" width="87" height="18"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                            <scroller key="verticalScroller" horizontal="NO" id="output-vertical">
                                <rect key="frame" x="602" y="0" width="15" height="350"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                        </scrollView>
                        <scrollView borderType="none" hasHorizontalScroller="NO" hasVerticalScroller="YES" id="input-scroll">
                            <rect key="frame" x="0" y="0" width="617" height="55"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <clipView key="contentView" id="input-clip">
                                <rect key="frame" x="0" y="0" width="602" height="55"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <textView importsGraphics="NO" verticallyResizable="YES" allowsUndo="YES" id="input-text" customClass="RDAtlantisTextInputView">
                                        <rect key="frame" x="0" y="0" width="602" height="46"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <size key="minSize" width="114" height="46"/>
                                        <size key="maxSize" width="602" height="10000000"/>
                                        <connections>
                                            <outlet property="passInputsTo" destination="output-text" id="input-keyboard-route"/>
                                        </connections>
                                    </textView>
                                </subviews>
                            </clipView>
                            <scroller key="horizontalScroller" hidden="YES" horizontal="YES" id="input-horizontal">
                                <rect key="frame" x="-100" y="-100" width="87" height="18"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                            <scroller key="verticalScroller" horizontal="NO" id="input-vertical">
                                <rect key="frame" x="602" y="0" width="15" height="55"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                        </scrollView>
                    </subviews>
                </customView>
                <customView id="spawn-status" userLabel="Status Bar" customClass="ImageBackgroundView">
                    <rect key="frame" x="0" y="412" width="617" height="21"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <subviews>
                        <imageView id="status-separator">
                            <rect key="frame" x="530" y="3" width="2" height="14"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES"/>
                            <imageCell key="cell" imageScaling="none" image="StatusSep" id="status-separator-cell"/>
                        </imageView>
                        <textField verticalHuggingPriority="750" id="status-timer">
                            <rect key="frame" x="527" y="3" width="73" height="14"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES"/>
                            <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="center" title="00:00:00" id="status-timer-cell">
                                <font key="font" metaFont="system" size="11"/>
                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                        <textField verticalHuggingPriority="750" id="status-message">
                            <rect key="frame" x="3" y="3" width="522" height="14"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                            <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="left" title="" id="status-message-cell">
                                <font key="font" metaFont="system" size="11"/>
                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                        <imageView id="status-lock">
                            <rect key="frame" x="596" y="2" width="16" height="16"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES"/>
                            <imageCell key="cell" imageScaling="none" id="status-lock-cell"/>
                        </imageView>
                    </subviews>
                </customView>
            </subviews>
        </customView>
    </objects>
    <resources>
        <image name="StatusSep" width="2" height="14"/>
    </resources>
</document>
